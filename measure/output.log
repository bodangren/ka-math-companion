@@ -18,4 +18,36 @@
 
 renderDisplay : String -> MathExpr
 renderDisplay latex =
     DisplayMath latex
+
+
+parseMath : String -> List MathExpr
+parseMath text =
+    let
+        extractDisplay acc str =
+            case String.indexes "$$" str of
+                [] ->
+                    if String.isEmpty str then
+                        List.reverse acc
+                    else
+                        List.reverse <| InlineMath str :: acc
+
+                firstPos :: _ ->
+                    let
+                        before = String.slice str 0 firstPos
+                        afterStart = firstPos + 2
+                        rest = String.slice str afterStart (String.length str)
+                    in
+                    case String.indexes "$$" rest of
+                        [] ->
+                            List.reverse <|
+                                (InlineMath <| before ++ "$$" ++ rest) :: acc
+
+                        secondPos :: _ ->
+                            let
+                                latex = String.slice rest 0 secondPos
+                                after = String.slice rest (secondPos + 2) (String.length rest)
+                            in
+                            extractDisplay (DisplayMath latex :: InlineMath before :: acc) after
+    in
+    extractDisplay [] text

