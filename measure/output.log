module Route.Path exposing (Path(..), fromString, fromUrl, href, toString)

import Html
import Html.Attributes
import Url exposing (Url)
import Url.Parser exposing ((</>))


type Path
    = Home_
    | Curriculum
    | Curriculum_Unit_ { unit : String }
    | Curriculum_Unit__Lesson_ { unit : String, lesson : String }
    | Design_System_ { design_System : String }
    | NotFound_


fromUrl : Url -> Path
fromUrl url =
    fromString url.path
        |> Maybe.withDefault NotFound_


fromString : String -> Maybe Path
fromString urlPath =
    let
        urlPathSegments : List String
        urlPathSegments =
            urlPath
                |> String.split "/"
                |> List.filter (String.trim >> String.isEmpty >> Basics.not)
    in
    case urlPathSegments of
        [] ->
            Just Home_

        "curriculum" :: [] ->
            Just Curriculum

        "curriculum" :: unit_ :: [] ->
            Curriculum_Unit_
                { unit = unit_
                }
                |> Just

        "curriculum" :: unit_ :: lesson_ :: [] ->
            Curriculum_Unit__Lesson_
                { unit = unit_
                , lesson = lesson_
                }
                |> Just

        design_System_ :: [] ->
            Design_System_
                { design_System = design_System_
                }
                |> Just

        _ ->
            Nothing


href : Path -> Html.Attribute msg
href path =
    Html.Attributes.href (toString path)


toString : Path -> String
toString path =
    let
        pieces : List String
        pieces =
            case path of
                Home_ ->
                    []

                Curriculum ->
                    [ "curriculum" ]

                Curriculum_Unit_ params ->
                    [ "curriculum", params.unit ]

                Curriculum_Unit__Lesson_ params ->
                    [ "curriculum", params.unit, params.lesson ]

                Design_System_ params ->
                    [ params.design_System ]

                NotFound_ ->
                    [ "404" ]
    in
    pieces
        |> String.join "/"
        |> String.append "/"
