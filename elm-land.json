{
  "app": {
    "elm": {
      "development": { "debugger": true },
      "production": { "debugger": false }
    },
    "env": [],
    "html": {
      "attributes": {
        "html": { "lang": "en" },
        "head": {}
      },
      "title": "KA Math Companion",
      "meta": [
        { "charset": "UTF-8" },
        { "http-equiv": "X-UA-Compatible", "content": "IE=edge" },
        {
          "name": "viewport",
          "content": "width=device-width, initial-scale=1.0"
        }
      ],
      "link": [
        { "rel": "preconnect", "href": "https://fonts.googleapis.com" },
        { "rel": "preconnect", "href": "https://fonts.gstatic.com", "crossorigin": "" },
        { "href": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Newsreader:ital,wght@0,400;0,600;0,700;1,400&display=swap", "rel": "stylesheet" }
      ],
      "script": [
        { "src": "https://cdn.tailwindcss.com" },
        { "content": "tailwind.config = { theme: { extend: { colors: { 'primary': '#EB001B', 'secondary': '#FF5F00', 'accent': '#F79E1B', 'surface': '#F9F7F2', 'anthracite': '#1A1A1A' }, fontFamily: { 'sans': ['Inter', 'sans-serif'], 'serif': ['Newsreader', 'serif'] }, borderRadius: { 'orbital': '24px' } } } }" },
        { "src": "/katex.js" }
      ]
    },
    "router": {
      "useHashRouting": false
    },
    "proxy": null
  }
}
